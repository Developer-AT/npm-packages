{
    "compilerOptions": {
        "declaration": true,
        "target": "es2022",
        "module": "commonjs",
        "incremental": true,
        "noEmit": false,
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "strictPropertyInitialization": false,
        "sourceMap": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "baseUrl": "."
    }
}
